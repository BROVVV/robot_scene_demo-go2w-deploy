SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_REASONING_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_TIMEOUT_SECONDS=25
SILICONFLOW_MAX_TOKENS=2048
SILICONFLOW_REASONING_TIMEOUT_SECONDS=40
SILICONFLOW_REASONING_MAX_TOKENS=2048
SILICONFLOW_REASONING_EFFORT=high
IMAGE_MAX_SIDE=1280
IMAGE_DETAIL=high
ENABLE_LOW_OBJECT_RETRY=true
MIN_OBJECTS_FOR_COMPLEX_SCENE=6
ENABLE_IMAGE_PREPROCESS=true
IMAGE_PREPROCESS_SHARPEN=false
IMAGE_PREPROCESS_DENOISE=false
ENABLE_TILED_DETECTION=false
TILE_SIZE=960
TILE_OVERLAP=160
ENABLE_TARGET_PROFILE=true
TARGET_PROFILE_LANGUAGE=zh_en
TARGET_PROFILE_MAX_TERMS=40
ENABLE_TARGET_SYNONYM_EXPANSION=true
ENABLE_CONTEXT_OBJECT_EXPANSION=true
OUTPUT_DIR=outputs

# Navigation2 integration (safe defaults: disabled and never execute)
NAV2_ENABLED=false
NAV2_MODE=disabled
NAV2_ROS_DISTRO=humble
NAV2_SYSTEM_PYTHON=/usr/bin/python3
NAV2_SETUP_BASH=/opt/ros/humble/setup.bash
NAV2_WORKSPACE_SETUP=
NAV2_NAMESPACE=
NAV2_MAP_FRAME=map
NAV2_ODOM_FRAME=odom
NAV2_BASE_FRAME=base_link
NAV2_CMD_VEL_TOPIC=/cmd_vel
NAV2_GLOBAL_PLAN_TOPIC=/plan
NAV2_LOCAL_PLAN_TOPIC=/local_plan
NAV2_PLANNER_ID=GridBased
NAV2_CONTROLLER_ID=FollowPath
NAV2_GOAL_CHECKER_ID=general_goal_checker
NAV2_BEHAVIOR_TREE=
NAV2_PLANNING_TIMEOUT_SECONDS=30
NAV2_EXECUTION_TIMEOUT_SECONDS=300
NAV2_FEEDBACK_INTERVAL_SECONDS=0.5
NAV2_CMD_VEL_SAMPLE_HZ=10
NAV2_OUTPUT_DIR=outputs/nav2
NAV2_OFFLINE_FIXTURE=data/nav2_demo/offline_path_fixture.json
NAV2_ALLOW_EXECUTE=false
NAV2_FOOTPRINT_CONFIRMED=false
NAV2_EMERGENCY_STOP_CONFIRMED=false
NAV2_NO_SILENT_FALLBACK=true
NAV2_LEGACY_CMD_VEL_ALLOWED=false
NAV2_AUTO_CANCEL_ON_TARGET_CONFIRMED=true
NAV2_TARGET_STANDOFF_DISTANCE_M=0.8
NAV2_MAX_SEMANTIC_GOAL_DISTANCE_M=20.0
NAV2_PATH_SIMPLIFY_EPSILON_M=0.08
NAV2_INSTRUCTION_TURN_THRESHOLD_DEG=15.0

DETECTION_BACKEND=llm
GROUNDED_SAM_ROOT=external/Grounded-SAM-2
GROUNDED_SAM_PYTHON=python
GROUNDED_SAM_PYTHONPATH=external/Grounded-SAM-2:external/Grounded-SAM-2/grounding_dino
GROUNDING_DINO_CONFIG=grounding_dino/groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_CHECKPOINT=gdino_checkpoints/groundingdino_swint_ogc.pth
GROUNDING_DINO_BOX_THRESHOLD=0.12
GROUNDING_DINO_TEXT_THRESHOLD=0.10
GROUNDING_DINO_HIGH_RECALL_BOX_THRESHOLD=0.10
GROUNDING_DINO_HIGH_RECALL_TEXT_THRESHOLD=0.08
ENABLE_GDINO_HIGH_RECALL=true
GROUNDING_PROMPT_LLM_EXPANSION_ENABLED=true
GROUNDING_PROMPT_REQUIRE_NON_EMPTY=true
GROUNDING_PROMPT_FAIL_FAST_ON_EMPTY=true
GROUNDING_PROMPT_RETRY_ON_EMPTY=true
GROUNDING_PROMPT_MAX_RETRIES=1
GROUNDING_PROMPT_MAX_TERMS=24
GROUNDING_PROMPT_MIN_TERMS=3
GROUNDING_PROMPT_DEBUG_OUTPUT=outputs/grounding_prompt_plan.json
GROUNDING_PROMPT_RETRY_DEBUG_OUTPUT=outputs/grounding_prompt_retry_plan.json
ENABLE_SAM2=true
ENABLE_SAM2_MASK_FEATURES=true
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_CHECKPOINT=checkpoints/sam2.1_hiera_tiny.pt
MAX_DETECTED_OBJECTS=100
DETECTION_DEVICE=auto
DETECTOR_TIMEOUT_SECONDS=60

# Candidate crop verification and score fusion
ENABLE_CROP_VERIFY=true
CROP_VERIFY_BACKEND=llm
CROP_VERIFY_MAX_CANDIDATES=40
CROP_VERIFY_EXPAND_RATIO=1.35
CROP_VERIFY_MIN_SCORE=0.55
CROP_VERIFY_TARGET_SCORE=0.70
CROP_VERIFY_TIMEOUT_SECONDS=60
CROP_VERIFY_SAVE_CROPS=true
CROP_VERIFY_OUTPUT_DIR=outputs/crops
ENABLE_SCORE_FUSION=true
FUSION_WEIGHT_DETECTOR=0.30
FUSION_WEIGHT_VLM=0.45
FUSION_WEIGHT_ATTRIBUTE=0.15
FUSION_WEIGHT_CONTEXT=0.10
FINAL_TARGET_SCORE_THRESHOLD=0.65
FINAL_CANDIDATE_SCORE_THRESHOLD=0.45

# Video detection and temporal voting
VIDEO_SAMPLE_FPS=3.0
VIDEO_MAX_FRAMES=300
VIDEO_ENABLE_TRACKING=true
VIDEO_TRACK_IOU_THRESHOLD=0.35
VIDEO_TRACK_MAX_MISSING_FRAMES=8
VIDEO_TRACK_MIN_HITS=2
VIDEO_TARGET_CONFIRM_MIN_FRAMES=3
VIDEO_TARGET_CONFIRM_SCORE=0.65
VIDEO_ENABLE_TRACK_LEVEL_VOTING=true
VIDEO_VERIFY_EVERY_N_FRAMES=2
VIDEO_SAVE_CANDIDATE_CROPS=true

# Evaluation
EVAL_IOU_THRESHOLD=0.5
EVAL_OUTPUT_DIR=outputs/eval

# Video scene memory and PSG reasoning
VIDEO_MODE_DEFAULT=target_search
VIDEO_ENABLE_SCENE_MAPPING_DEFAULT=false
VIDEO_ENABLE_NAVIGATION_TOPOLOGY_DEFAULT=false
VIDEO_USE_SCENE_MAP_FOR_SEARCH_DEFAULT=true
VIDEO_ALLOW_SCENE_MAP_ONLY_DEBUG=false
VIDEO_TARGET_SEARCH_REQUIRED_WHEN_TARGET_PRESENT=true
VIDEO_SCENE_MAPPING_REUSE_TARGET_FRAMES=true
VIDEO_SCENE_MAPPING_REUSE_OBJECT_TRACKS=true
VIDEO_ENABLE_SCENE_MEMORY=true
VIDEO_FULL_SCENE_MAP_ENABLED=false
VIDEO_ALWAYS_WRITE_MEMORY=true
VIDEO_ENABLE_VIDEO_PSG=true
VIDEO_TOPOLOGY_ANNOTATE_TARGET_SEARCH=true
VIDEO_TOPOLOGY_ADD_TARGET_CANDIDATE_NODES=true
VIDEO_TOPOLOGY_ADD_TARGET_SEARCH_SCORES=true
VIDEO_PSG_MAX_PREDICTED_NODES=30
VIDEO_PSG_CONFIDENCE_THRESHOLD=0.45
VIDEO_TOPOLOGY_OBSERVED_ONLY=false
VIDEO_SAVE_FRAME_OBSERVATIONS=true
VIDEO_ENABLE_NEGATIVE_EVIDENCE=true
VIDEO_ENABLE_REASONING_REPORT=true
VIDEO_MEMORY_STORE_PATH=data/memory/video_spatial_memory.jsonl
VIDEO_MIN_MEMORY_IMPORTANCE=low
VIDEO_LLM_FRAME_INTERVAL_SEC=2.0
VIDEO_PSG_SUMMARY_INTERVAL_SEC=5.0
VIDEO_MAX_MEMORY_ENTRIES_PER_VIDEO=200
VIDEO_MEMORY_DEDUP_SIMILARITY=0.86
VIDEO_ENABLE_MEMORY_RETRIEVAL=true
VIDEO_MEMORY_RETRIEVAL_TOP_K=10
VIDEO_SCENE_REASONER_BACKEND=llm
VIDEO_FORCE_JSON_OUTPUT=true

# Video-to-Navigation Planning (visual preview is safe and ROS-free by default)
VIDEO_NAVIGATION_ENABLED=true
VIDEO_NAVIGATION_MODE=visual_preview
VIDEO_POSE_BACKEND=auto
VIDEO_POSE_ALLOW_RELATIVE=true
VIDEO_POSE_REQUIRE_METRIC_FOR_NAV2=true
VIDEO_NAVIGATION_AUTO_PLAN=true
VIDEO_NAVIGATION_AUTO_EXPLORATION=true
VIDEO_NAVIGATION_MAX_FRAMES=300
VIDEO_NAVIGATION_FRAME_SAMPLE_INTERVAL=5
VIDEO_NAVIGATION_MIN_TRACK_CONFIDENCE=0.5
VIDEO_NAVIGATION_TARGET_OBSERVATION_DISTANCE=1.5
VIDEO_NAVIGATION_ENABLE_FRONTIER_EXPLORATION=true
VIDEO_NAVIGATION_EXPLORATION_MAX_CANDIDATES=8
VIDEO_NAVIGATION_EXPLORATION_MIN_INFORMATION_GAIN=0.2
VIDEO_NAVIGATION_ALLOW_NAV2_FROM_METRIC_VIDEO=false
VISUAL_NAV_EXECUTION_ENABLED=false

# LLM-first situated search reasoning for quadruped robots
ENABLE_LLM_SITUATED_REASONING=true
ENABLE_LLM_REASONING_MEMORY=true
LLM_REASONING_MAX_HYPOTHESES=5
LLM_REASONING_TIMEOUT_SECONDS=40
LLM_REASONING_TEMPERATURE=0.2
LLM_REASONING_REQUIRE_ACTIONABILITY_GATE=true
LLM_REASONING_REQUIRE_VISUAL_GATE=true
QUADRUPED_MAX_FORWARD_STEP_M=0.5
QUADRUPED_CAN_MANIPULATE=false
QUADRUPED_CAN_OPEN_CONTAINER=false
QUADRUPED_CAN_LOOK_DOWN=false
LLM_EXPERIENCE_MEMORY_PATH=data/memory/llm_spatial_experience.jsonl
ENABLE_LLM_DYNAMIC_VISUAL_RETRY=true
LLM_DYNAMIC_VISUAL_RETRY_MAX_TERMS=12

# Platform-assisted adaptive motion horizon.
# Obstacle avoidance is assumed to be handled by the robot platform/SDK/ROS safety layer.
PLATFORM_OBSTACLE_AVOIDANCE_ASSUMED=true
ENABLE_DYNAMIC_MOTION_HORIZON=true
MOTION_HORIZON_PROFILE=platform_assisted_auto
MOTION_STRICT_SAFE_MAX_STEP_M=0.5
MOTION_PLATFORM_INDOOR_DEFAULT_STEP_M=1.2
MOTION_PLATFORM_INDOOR_MAX_STEP_M=2.0
MOTION_PLATFORM_OPEN_DEFAULT_STEP_M=3.0
MOTION_PLATFORM_OPEN_MAX_STEP_M=5.0
MOTION_ABSOLUTE_MAX_STEP_M=6.0
MOTION_TARGET_CONFIRM_MAX_STEP_M=0.8
MOTION_PLATFORM_FALLBACK_STEP_M=1.5
MOTION_DEFAULT_STOP_AND_REOBSERVE=true
MOTION_ENABLE_OBSERVE_WHILE_MOVING=false
MOTION_SOFT_OBSERVE_INTERVAL_SEC=1.0
MOTION_SHORTEN_ON_TARGET_CANDIDATE=true
MOTION_ALLOW_LLM_RECOMMENDED_HORIZON=true
MOTION_LLM_HORIZON_WEIGHT=0.6

# ================================
# Handcrafted prior control
# ================================
STATIC_KNOWLEDGE_BASE_ENABLED=false
HANDWRITTEN_OBJECT_PRIORS_ENABLED=false
HANDWRITTEN_LOCATION_PRIORS_ENABLED=false
HANDWRITTEN_ROOM_PRIORS_ENABLED=false
STATIC_OBJECT_PROMPTS_ENABLED=false
ALLOW_HANDCRAFTED_SEARCH_RULES=false

# ================================
# LLM-generated runtime commonsense prior
# ================================
LLM_COMMONSENSE_PRIOR_ENABLED=true
LLM_PRIOR_GENERATION_MODE=runtime
LLM_PRIOR_REQUIRE_REASON=true
LLM_PRIOR_ALLOW_SEARCH_HINTS=true
LLM_PRIOR_ALLOW_DETECTOR_PROMPTS=true
LLM_PRIOR_CAN_CONFIRM_TARGET=false
LLM_PRIOR_MAX_HYPOTHESES=8
LLM_PRIOR_MAX_DETECTOR_PROMPTS=12
LLM_PRIOR_OUTPUT_LANGUAGE=zh

# ================================
# Evidence gating
# ================================
EVIDENCE_GATING_ENABLED=true
VIDEO_TARGET_CONFIRMATION_BY_CONTEXT_ONLY=false
TARGET_CONFIRMATION_REQUIRE_VISUAL_EVIDENCE=true
TARGET_CONFIRMATION_REQUIRE_BBOX=true
TARGET_CONFIRMATION_REQUIRE_CROP_VERIFY=true
TARGET_CONFIRMATION_REQUIRE_MASK=false
TARGET_CONFIRMATION_MIN_SCORE=0.72
TARGET_INFERRED_IS_NOT_FOUND=true
VIDEO_SEARCH_RANKER_ENABLED=true
VIDEO_SEARCH_RANKER_HIGH_SCORE_THRESHOLD=0.70
VIDEO_SEARCH_RANKER_CONTEXT_ONLY_CAN_CONFIRM=false

# ================================
# Observation memory
# ================================
OBSERVATION_MEMORY_ENABLED=true
OBSERVATION_MEMORY_STORE_PATH=data/memory/observational_memory.jsonl
OBSERVATION_MEMORY_WRITE_VISUAL_ONLY=true
OBSERVATION_MEMORY_ALLOW_LLM_SUMMARY=true
OBSERVATION_MEMORY_LLM_SUMMARY_AS_HYPOTHESIS=true
OBSERVATION_MEMORY_RETRIEVAL_TOP_K=10
OBSERVATION_MEMORY_REQUIRE_PROVENANCE=true

# SemanticNavigation-style live semantic next-view reasoning. Safe defaults preserve the
# existing legacy scan behavior until explicitly enabled.
LIVE_SEARCH_SEMANTIC_REASONING_ENABLED=false
LIVE_SEARCH_REASONER_BACKEND=legacy
LIVE_SEARCH_REASONER_MODE=shadow
LIVE_SEARCH_REASONER_MIN_CONFIDENCE=0.55
LIVE_SEARCH_REASONER_ALLOW_FORWARD=false
LIVE_SEARCH_REASONER_MAX_TURN_DEG=30
LIVE_SEARCH_REASONER_MIN_REPLAN_SECONDS=5.0
LIVE_SEARCH_REASONER_SCENE_TTL_SECONDS=10.0
LIVE_SEARCH_GRAPH_MATCH_PARTIAL_THRESHOLD=0.30
LIVE_SEARCH_GRAPH_MATCH_STRONG_THRESHOLD=0.72
LIVE_SEARCH_NEGATIVE_MEMORY_ENABLED=true
LIVE_SEARCH_NEGATIVE_MEMORY_TTL_SECONDS=300
LIVE_SEARCH_REASONER_USE_PSG=true
LIVE_SEARCH_REASONER_USE_OBSERVATION_MEMORY=true
LIVE_SEARCH_REASONER_USE_LLM_SITUATED_PRIOR=true
LIVE_SEARCH_REASONER_DEBUG_OUTPUT_DIR=outputs/live_reasoning

# ================================
# PandarXT-16 diagnostic preprocessor & dual-LiDAR safety (fail-closed)
# The Pandar stream stays diagnostic-only until a multi-scene extrinsic
# calibration passes; dual-lidar safety fusion must remain disabled by default.
# ================================
PANDARXT16_ENABLED=false
PANDARXT16_DIAGNOSTIC_PREPROCESS_ENABLED=false
PANDARXT16_ZERO_RETURN_MAX_M=0.05
PANDARXT16_CLOCK_REQUIRE_VALIDATED_FOR_METRIC=true

DUAL_LIDAR_SAFETY_ENABLED=false
DUAL_LIDAR_REQUIRE_VALIDATED_EXTRINSICS=true
DUAL_LIDAR_UNKNOWN_IS_CLEAR=false
DUAL_LIDAR_MAX_EVIDENCE_AGE_SECONDS=0.5

# ================================
# Current hardware geometry (operator-confirmed 2026-08-13)
# Whole machine 0.70 x 0.43 x 0.70 m; highest point is the fixed PandarXT-16
# protective frame (not a loose cable). No re-measurement is scheduled.
# ================================
GO2W_CURRENT_LENGTH_M=0.70
GO2W_CURRENT_WIDTH_M=0.43
GO2W_CURRENT_HEIGHT_M=0.70
GO2W_CURRENT_HIGHEST_POINT=pandarxt16_protective_frame
GO2W_CURRENT_GEOMETRY_CONFIG=configs/go2w/current_hardware_geometry.yaml
GO2W_CURRENT_STATE_CONFIG=configs/go2w/current_hardware_state.yaml
GO2W_PANDAR_PREPROCESS_CONFIG=configs/go2w/hesai_pandarxt16_preprocess.yaml

# ================================
# Prior usage audit
# ================================
PRIOR_USAGE_AUDIT_ENABLED=true
PRIOR_USAGE_REPORT_PATH=outputs/prior_usage_report.json

# ================================
# Go2-W 真机（LLM 线路为默认；不含任何密钥）
# 完整参考：.env.go2w（本仓库内）
# ================================
GO2W_LIVE_MODE_ENABLED=true
GO2W_FRAME_SPOOL_DIR=runtime/go2w/spool
GO2W_SESSION_OUTPUT_DIR=outputs/live_sessions

LIVE_FRAME_SAMPLE_FPS=1.0
LIVE_FRAME_QUEUE_SIZE=1
LIVE_DROP_STALE_FRAMES=true
LIVE_MAX_FRAME_AGE_SECONDS=1.0

DETECTION_BACKEND=llm

LLM_COMMONSENSE_PRIOR_ENABLED=true
LLM_PRIOR_GENERATION_MODE=runtime
LLM_PRIOR_CAN_CONFIRM_TARGET=false

EVIDENCE_GATING_ENABLED=true
TARGET_CONFIRMATION_REQUIRE_VISUAL_EVIDENCE=true
TARGET_CONFIRMATION_REQUIRE_BBOX=true
TARGET_CONFIRMATION_REQUIRE_CROP_VERIFY=true
TARGET_CONFIRMATION_MIN_SCORE=0.72

OBSERVATION_MEMORY_ENABLED=true
OBSERVATION_MEMORY_WRITE_VISUAL_ONLY=true
OBSERVATION_MEMORY_REQUIRE_PROVENANCE=true

PLATFORM_OBSTACLE_AVOIDANCE_ASSUMED=false
ENABLE_DYNAMIC_MOTION_HORIZON=true
MOTION_HORIZON_PROFILE=strict_safe
MOTION_STRICT_SAFE_MAX_STEP_M=0.3
MOTION_ABSOLUTE_MAX_STEP_M=0.5
MOTION_TARGET_CONFIRM_MAX_STEP_M=0.2
MOTION_DEFAULT_STOP_AND_REOBSERVE=true
MOTION_ENABLE_OBSERVE_WHILE_MOVING=false
MOTION_SHORTEN_ON_TARGET_CANDIDATE=true
VISUAL_NAV_EXECUTION_ENABLED=false
VIDEO_NAVIGATION_ALLOW_NAV2_FROM_METRIC_VIDEO=false

NAV2_ENABLED=false
NAV2_MODE=disabled
NAV2_ALLOW_EXECUTE=false
NAV2_FOOTPRINT_CONFIRMED=false
NAV2_EMERGENCY_STOP_CONFIRMED=false
NAV2_CMD_VEL_TOPIC=/go2w/nav2_cmd_vel
NAV2_NO_SILENT_FALLBACK=true

# ---- Go2-W Manual WASD+QE Web Demo (app/manual_web_demo) ----
# Independent small demo: browser camera + WASD+QE via existing /go2w/motion
# Action chain + SiliconFlow scene object table. See docs/GO2W_MANUAL_WASD_WEB_DEMO.md
MANUAL_DEMO_HOST=127.0.0.1
MANUAL_DEMO_PORT=8765

MANUAL_DEMO_CAMERA_MAX_FPS=10
MANUAL_DEMO_CAMERA_STALE_SECONDS=1.0

# LLM analysis is OFF by default to save tokens; toggle it live from the WebUI
# button (大模型分析: 开/关) or via POST /api/llm/enable|disable.
MANUAL_DEMO_LLM_ENABLED=false
MANUAL_DEMO_LLM_INTERVAL_SECONDS=5
MANUAL_DEMO_LLM_HIDE_LOW_CONFIDENCE=true

# SiliconFlow API key / endpoint / model are NOT duplicated here. The demo
# reads the existing SILICONFLOW_* settings from this file / app.config.py.

MANUAL_DEMO_CONTROL_ENABLED=false

MANUAL_DEMO_DEADMAN_MS=300
MANUAL_DEMO_ROS_WORKER_DEADMAN_MS=500
MANUAL_DEMO_REPEAT_INTERVAL_MS=250

MANUAL_DEMO_ALLOW_FORWARD=true
MANUAL_DEMO_ALLOW_BACKWARD=false
MANUAL_DEMO_ALLOW_STRAFE=false
MANUAL_DEMO_ALLOW_TURN=true
MANUAL_DEMO_TURN_STEP_DEG=8

# Continuous hold motion: while a key is held the demo keeps ONE timed-velocity
# goal running (renewed on completion) so the robot moves continuously with no
# per-step pause. Turns use a continuous yaw_rate (no per-step angle limit).
MANUAL_DEMO_PULSE_VX=0.12
MANUAL_DEMO_PULSE_VX_BACKWARD=0.10
MANUAL_DEMO_PULSE_VY=0.06
MANUAL_DEMO_TURN_YAW_RATE=0.15
MANUAL_DEMO_HOLD_DURATION_SEC=30.0

MANUAL_DEMO_MIN_FRONT_CLEARANCE_M=0.30
MANUAL_DEMO_SAVE_ANALYSIS_FRAMES=false

MANUAL_DEMO_RUNTIME_DIR=outputs/manual_web_demo/runtime
MANUAL_DEMO_LOGS_DIR=outputs/manual_web_demo/logs
MANUAL_DEMO_ANALYSIS_FRAMES_DIR=outputs/manual_web_demo/analysis_frames
# ROS worker subprocess (system Python; ROS env sourced by the start script).
MANUAL_DEMO_ROS_WORKER=/usr/bin/python3 scripts/go2w/manual_web_demo_ros_worker.py

# ---------------------------------------------------------------------------
# VLM-only low-latency semantic navigation runtime (2026-08-28 plan)
# ---------------------------------------------------------------------------
VLM_RUNTIME_TRANSPORT=daemon
VLM_RUNTIME_FALLBACK_TO_SUBPROCESS=true
VLM_RUNTIME_ALLOW_API_CONCURRENCY=true
VLM_RUNTIME_QUICK_MAX_TOKENS=256
VLM_RUNTIME_VERIFY_MAX_TOKENS=256
VLM_RUNTIME_SEMANTIC_MAX_TOKENS=1536
VLM_RUNTIME_QUICK_TIMEOUT_SECONDS=20
VLM_RUNTIME_VERIFY_TIMEOUT_SECONDS=20
VLM_RUNTIME_SEMANTIC_TIMEOUT_SECONDS=45
VLM_RUNTIME_SEMANTIC_BACKGROUND_ENABLED=true
VLM_RUNTIME_SEMANTIC_INITIAL_WARMUP_BLOCKING=true
VLM_RUNTIME_SEMANTIC_MAX_INFLIGHT=1
VLM_RUNTIME_SEMANTIC_TTL_SECONDS=12
VLM_RUNTIME_SEMANTIC_TRANSLATION_REFRESH_M=0.30
VLM_RUNTIME_SEMANTIC_HEADING_SECTOR_DEG=30
VLM_RUNTIME_SEMANTIC_VISUAL_CHANGE_ENABLED=true
VLM_RUNTIME_PLANNER_SEMANTIC_SOFT_STALE_SECONDS=15
VLM_RUNTIME_PLANNER_SEMANTIC_HARD_STALE_SECONDS=45
VLM_RUNTIME_VERIFY_SAME_FRAME_MAX_CALLS=1
