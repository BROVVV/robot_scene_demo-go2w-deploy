DETECTION_DEVICE=auto
DETECTOR_TIMEOUT_SECONDS=60

# YOLOE-Seg 使用独立环境，避免改变 Grounded-SAM 的 Torch/Ultralytics 依赖。
# 默认使用带内置大词汇表的 *-seg-pf.pt：推理时不注入场景词表，也不切换 prompt。
# 如改回 *-seg.pt 文本提示权重，才会使用下面的 YOLOE_TEXT_ENCODER。
YOLOE_PYTHON=/home/mxt/robotscene/.yoloe_env/bin/python
YOLOE_MODEL=/home/mxt/robotscene/models/yoloe-26s-seg-pf.pt
YOLOE_TEXT_ENCODER=/home/mxt/robotscene/mobileclip2_b.ts
YOLOE_DEVICE=cuda:0
YOLOE_PRECISION=fp16
YOLOE_CONFIDENCE=0.25
YOLOE_IOU_THRESHOLD=0.50
YOLOE_IMAGE_SIZE=640
YOLOE_MAX_DETECTIONS=100
YOLOE_TIMEOUT_SECONDS=30

# 感知提速（2026-10-13 计划）阶段一：两个等价优化 + 一个计时开关。
# 前两项默认开、关掉就是旧路径；第三项会给每个阶段插 CUDA 同步，只用于测量。
ENABLE_DINO_FRAME_FEATURE_CACHE=true
MASK_RLE_ENCODER=vector
DETECTION_PROFILE_ENABLED=false

# 感知提速（2026-10-13 计划）阶段二 · 任务 6：多词分组前向。
# per_term（默认）= 每个词一次 predict()，与阶段一逐字相同、也是验收基线。
# grouped = 多个词拼成一条 caption 只做一次 predict()，再用 token 跨度把框关联
#           回词。**它是一次待评估的实验**：默认保持 per_term，除非
#           reports/perception_optimization_phase_2.md 的质量门槛判为采用。
# 生效值怎么取：这个开关的**值**来自本文件，而 `get_settings()` 有 lru_cache ——
# 所以改了它要**重启 WebUI** 才生效（worker 继承 WebUI 的环境，见
# reports/perception_optimization_phase_2.md §6）。它之所以"走请求体"
# （`grounded_sam_subprocess._request` 把 `dino_prompt_mode` 塞进 JSON，
# worker 侧读 `request.get(key, args.key)`），是为了让**调用方**能逐个请求
# 覆盖它而不用重启 —— 说的是 worker 不用重启，不是"改 .env 不用重启"。
GO2W_DINO_PROMPT_MODE=per_term

# RAM++ (recognize-anything) 场景标签通路
# 和 GroundingDINO/SAM2 共用同一个常驻 worker，不额外起 daemon。
# RAM_SCENE_TAG_INTERVAL_SECONDS 是「最多多久问一次 RAM++」，不是每帧都问。
# 必须写成绝对路径：worker 启动后会 chdir 到 GROUNDED_SAM_ROOT，相对路径会解析错。
RAM_PLUS_ROOT=/home/mxt/robotscene/external/recognize-anything
RAM_PLUS_CHECKPOINT=/home/mxt/robotscene/external/ram_plus_ckpt/ram_plus_swin_large_14m.pth
ENABLE_RAM_PLUS=true
RAM_SCENE_TAG_INTERVAL_SECONDS=1.8
RAM_SCENE_MAX_TERMS=12

