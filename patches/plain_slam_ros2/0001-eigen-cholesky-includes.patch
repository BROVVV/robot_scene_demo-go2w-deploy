From 2871012040275053a4c2673de302931ebb94dcc0 Mon Sep 17 00:00:00 2001
From: robot_scene <deploy@example.invalid>
Date: Mon, 31 Aug 2026 11:42:24 +0800
Subject: [PATCH] patch: include Eigen Cholesky/SparseCholesky headers for
 Eigen 3.4

---
 include/plain_slam/gicp.hpp             | 1 +
 src/graph_optimizer.cpp                 | 1 +
 src/hierarchical_geometric_observer.cpp | 1 +
 3 files changed, 3 insertions(+)

diff --git a/include/plain_slam/gicp.hpp b/include/plain_slam/gicp.hpp
index 816251a..d9c064b 100644
--- a/include/plain_slam/gicp.hpp
+++ b/include/plain_slam/gicp.hpp
@@ -24,6 +24,7 @@
 
 #pragma once
 
+#include <Eigen/Cholesky>
 #include <sophus/se3.hpp>
 
 #include <plain_slam/types.hpp>
diff --git a/src/graph_optimizer.cpp b/src/graph_optimizer.cpp
index 6c9d429..daad647 100644
--- a/src/graph_optimizer.cpp
+++ b/src/graph_optimizer.cpp
@@ -22,6 +22,7 @@
  *   Subject: [plain_slam_ros2] Commercial License Inquiry
  */
 
+#include <Eigen/SparseCholesky>
 #include <plain_slam/graph_optimizer.hpp>
 
 namespace pslam {
diff --git a/src/hierarchical_geometric_observer.cpp b/src/hierarchical_geometric_observer.cpp
index e657658..99432a8 100644
--- a/src/hierarchical_geometric_observer.cpp
+++ b/src/hierarchical_geometric_observer.cpp
@@ -22,6 +22,7 @@
  *   Subject: [plain_slam_ros2] Commercial License Inquiry
  */
 
+#include <Eigen/Cholesky>
 #include <plain_slam/hierarchical_geometric_observer.hpp>
 
 namespace pslam {
