+ControllerServer::on_shutdown(const rclcpp_lifecycle::State & state)
 {
   RCLCPP_INFO(get_logger(), "Shutting down");
+  // Shutdown is also legal directly from active or inactive. Release plugin
+  // ownership while ROS and the costmap executor are still available, just as
+  // in the manager's deactivate -> cleanup -> shutdown sequence.
+  if (state.id() == lifecycle_msgs::msg::State::PRIMARY_STATE_ACTIVE) {
+    on_deactivate(state);
+  }
+  if (action_server_) {
+    action_server_->deactivate();
+  }
+  if (vel_publisher_ && rclcpp::ok()) {
+    publishZeroVelocity();
+  }
+  if (costmap_configured_) {
+    on_cleanup(state);
+  } else {
+    action_server_.reset();
+    progress_checker_.reset();
+    goal_checker_.reset();
+  }
   return nav2_util::CallbackReturn::SUCCESS;
 }
 
