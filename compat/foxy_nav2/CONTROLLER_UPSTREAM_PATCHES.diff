+
+void ControllerServer::readControllerParameters()
+{
+  const std::vector<rclcpp::Parameter> parameters{
+    get_parameter("controller_frequency"), get_parameter("min_x_velocity_threshold"),
+    get_parameter("min_y_velocity_threshold"), get_parameter("min_theta_velocity_threshold"),
+    get_parameter("failure_tolerance"), get_parameter("publish_zero_velocity")};
+  // Initial overrides bypass set-parameter callbacks. Validate them as well;
+  // the caller already owns the action mutex, so use a separate validator.
+  ControllerParameters validator;
+  const auto result = validator.validate(parameters);
+  if (!result.successful) {
+    throw std::invalid_argument(result.reason);
+  }
+  controller_frequency_ = parameters[0].as_double();
+  min_x_velocity_threshold_ = parameters[1].as_double();
+  min_y_velocity_threshold_ = parameters[2].as_double();
+  min_theta_velocity_threshold_ = parameters[3].as_double();
+  publish_zero_velocity_ = parameters[5].as_bool();
 }
 
