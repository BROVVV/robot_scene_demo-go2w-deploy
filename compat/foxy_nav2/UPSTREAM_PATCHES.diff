+TEST_F(TransformGlobalPlanTest, dynamic_speed_changes_computed_commands)
+{
+  configure_costmap(10u, 0.1);
+  configure_controller(10.0);
+  ctrl_->activate();
+  auto map = costmap_->getCostmap();
+  std::fill(map->getCharMap(), map->getCharMap() + map->getSizeInCellsX() * map->getSizeInCellsY(),
+    nav2_costmap_2d::FREE_SPACE);
+  geometry_msgs::msg::PoseStamped pose;
+  pose.header.frame_id = COSTMAP_FRAME;
+  pose.pose.position.x = 5.0;
+  pose.pose.position.y = 5.0;
+  pose.pose.orientation.w = 1.0;
+  setup_transforms(pose.pose.position);
+  pose.header.stamp = transform_time_;
+  nav_msgs::msg::Path path;
+  path.header.frame_id = PATH_FRAME;
+  path.header.stamp = transform_time_;
+  for (int i = 0; i <= 30; ++i) {
+    auto waypoint = pose;
+    waypoint.header = path.header;
+    waypoint.pose.position.x += 0.1 * i;
+    path.poses.push_back(waypoint);
+  }
+  geometry_msgs::msg::Twist stopped;
+  for (double speed : {0.15, 0.07, 0.12}) {
+    const auto result = node_->set_parameters_atomically({
+      rclcpp::Parameter("test_rpp.desired_linear_vel", speed)});
+    ASSERT_TRUE(result.successful) << result.reason;
+    EXPECT_DOUBLE_EQ(ctrl_->getSpeed(), speed);
+    ctrl_->setPlan(path);
+    auto command = ctrl_->computeVelocityCommands(pose, stopped);
+    EXPECT_NEAR(command.twist.linear.x, speed, 1e-6);
+    EXPECT_NEAR(command.twist.angular.z, 0., 1e-6);
+  }
+  // Reject the entire atomic update before touching the controller's speed.
+  auto changed = node_->set_parameters_atomically({
+    rclcpp::Parameter("test_rpp.desired_linear_vel", 0.3),
+    rclcpp::Parameter("goal_checker.xy_goal_tolerance", 0.8)});
+  EXPECT_FALSE(changed.successful);
+  EXPECT_DOUBLE_EQ(ctrl_->getSpeed(), 0.12);
+  EXPECT_DOUBLE_EQ(node_->get_parameter("goal_checker.xy_goal_tolerance").as_double(), 0.25);
+  ctrl_->deactivate();
+  ctrl_->cleanup();
+}
