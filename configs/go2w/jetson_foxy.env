# Non-secret Jetson Foxy profile. Source explicitly for the sidecar release.
GO2W_JETSON_PROFILE=1
GO2W_RELEASE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
GO2W_ROS_SETUP=/opt/ros/foxy/setup.bash
GO2W_HOST_IP=192.168.123.18
# USB Ethernet adapters can change eth0/eth1 numbering at boot. Select the
# unique interface owning the internal address; never guess on ambiguity.
GO2W_INTERFACE="$(ip -4 -o address show | awk -v host="$GO2W_HOST_IP" '
  { split($4, address, "/"); if (address[1] == host && $2 != "lo") { interface=$2; count++ } }
  END { if (count != 1) exit 1; print interface }
')" || {
  printf 'Jetson profile: internal IPv4 address must belong to exactly one interface.\n' >&2
  return 1 2>/dev/null || exit 1
}
GO2W_UNITREE_SETUP=/home/unitree/cyclonedds_ws/install/setup.bash
# Reuse the verified base; changed packages below override its implementations.
GO2W_WORKSPACE_SETUP=/home/unitree/robotscene_runtime/install/20261109_02/setup.bash
# Selected native description/time packages live in these verified base installs.
GO2W_HOST_STOP_ADDITIONAL_INSTALLS=/home/unitree/robotscene_runtime/install/ros2_ws:/home/unitree/robotscene_runtime/install/20261104_01
# Candidate: build the four selected packages in a fresh overlay before starting.
GO2W_LIDAR_HOTPATH_SETUP=/home/unitree/robotscene_runtime/install/20261117_24_localization_fast_gate/setup.bash
GO2W_FLOOR_MAP_EXECUTOR=single
GO2W_CONTROL_SETUP=/home/unitree/robotscene_runtime/install/20261104_control/setup.bash
GO2W_NAV2_SAFETY_SETUP=/home/unitree/robotscene_runtime/install/20261106_nav2_compat/local_setup.bash
GO2W_NAV2_RPP_SETUP=/home/unitree/robotscene_runtime/install/20261106_rpp_compat/local_setup.bash
GO2W_NAV2_SPIN_SETUP=/home/unitree/robotscene_runtime/install/20261106_spin_compat/local_setup.bash
GO2W_NAV2_BT_SETUP=/home/unitree/robotscene_runtime/install/20261106_bt_compat/local_setup.bash
GO2W_NAV2_CONTROLLER_SETUP=/home/unitree/robotscene_runtime/install/20261109_02_controller_compat/local_setup.bash
GO2W_FOXY_SPIN_ACTION=1
GO2W_CONTROL_PYTHON=/home/unitree/robotscene_runtime/venvs/control-py38/bin/python
# Independent lease-owner STOP if the controller/socket client goes silent.
GO2W_SDK_COMMAND_TIMEOUT_SECONDS=0.3
GO2W_SDK_RPC_TIMEOUT_SECONDS=0.2
GO2W_HESAI_CONFIG="$GO2W_RELEASE_ROOT/configs/go2w/hesai_pandarxt16_jetson.yaml"
GO2W_CONDA_PYTHON=/home/unitree/robotscene_runtime/venvs/web-py38/bin/python
GO2W_ROS_APP_SITE_PACKAGES=/home/unitree/robotscene_runtime/venvs/web-py38/lib/python3.8/site-packages
# Fresh isolated environment: fixed wheel lock, CUDA/golden/protocol verified.
YOLOE_PYTHON=/home/unitree/robotscene_runtime/venvs/ml-jetpack51-20261110-isolated/bin/python
YOLOE_MODEL="$GO2W_RELEASE_ROOT/models/yoloe-26s-seg-pf.pt"
YOLOE_TIMEOUT_SECONDS=90
# Keep detector CPU pre/post-processing behind sensor and motion callbacks.
# This changes scheduling only; model quality and request cadence stay intact.
GO2W_ML_NICE=10
GO2W_RUNTIME_ROOT=/home/unitree/robotscene_runtime
GO2W_WEB_3D_MAP_ENABLED=0
GO2W_WEB_2D_MAP_ENABLED=1
GO2W_WEB_POINTCLOUD_BRIDGE_ENABLED=0
GO2W_LIDAR_CLOUD_QUEUE_DEPTH=1
GO2W_PERCEPTION_MODE=2d
# Small geometry matrices should not compete across all four 15W CPU cores.
OPENBLAS_NUM_THREADS=1
# Configure Torch CPU pool before imports on the four-core 15W profile.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
PYTHONNOUSERSITE=1
MANUAL_DEMO_HOST=0.0.0.0
GO2W_WEB_BIND=0.0.0.0
GO2W_WEB_PORT=8765
MANUAL_DEMO_CAMERA_MAX_FPS=10
MANUAL_DEMO_CAMERA_OWNER=http_preferred
# Native Foxy state replay and isolated Action/camera probes verified.
MANUAL_DEMO_ROS_EXECUTOR=single
GO2W_WEB_VIDEO_MAX_WIDTH=640
GO2W_WEB_VIDEO_QUALITY=65
D435_BASE_URL=http://127.0.0.1:8080
D435_CAPTURE_CLOCK_MODE=shared_host
GO2W_ROS_CAMERA_ON_DEMAND=1
# The workstation's loopback proxy does not exist on the robot.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=127.0.0.1,localhost,::1,192.168.123.18
no_proxy=127.0.0.1,localhost,::1,192.168.123.18
GO2W_CAMERA_URL=http://127.0.0.1:8080/color?fps=10
GO2W_SEARCH_REPLAY_CAMERA_URL=http://127.0.0.1:8080/color?fps=10
AUTONOMOUS_SEARCH_ENABLE_AUTONOMOUS_MOTION=0

# Only encoded Web video is capped; atomic RGB-D capture remains unchanged.
MANUAL_DEMO_CAMERA_HTTP_URL=http://127.0.0.1:8080/color?fps=10

# Bounded stderr-only exit evidence for the unresolved native shutdown wait.
GO2W_YOLOE_EXIT_TRACE=1
